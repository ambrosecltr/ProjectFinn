# ==============================================================================
# Finn environment template
# ==============================================================================
# Start by filling the minimum required values below. Everything after that is
# optional and grouped by feature.

# ------------------------------------------------------------------------------
# Minimum required to boot
# ------------------------------------------------------------------------------
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
PUBLIC_URL=http://localhost:3000
DATABASE_URL=
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=anthropic:claude-sonnet-4-20250514
DEFAULT_API_KEY=
DEFAULT_BASE_URL=

# ------------------------------------------------------------------------------
# Server and admin
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
ADMIN_BEARER_TOKEN=
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Spectrum and user defaults
# ------------------------------------------------------------------------------
# Comma-separated allowlist. Leave empty to allow any inbound Spectrum sender.
SPECTRUM_ALLOWED_NUMBERS=
# Optional Business/dedicated iMessage line shown in the web dashboard fallback.
SPECTRUM_DEDICATED_LINE_PHONE=
# Optional bootstrap user and fallback timezone before browser/manual timezone wins.
USER_PHONE_NUMBER=
USER_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# LLM defaults and per-process overrides
# ------------------------------------------------------------------------------
# Providers: anthropic, openai, fireworks, deepseek, openai-compatible.
# Set *_BASE_URL only for openai-compatible endpoints, including the /v1 prefix.
DEFAULT_MAX_CONTEXT_TOKENS=128000
DEFAULT_MAX_OUTPUT_TOKENS=
DEFAULT_REASONING_EFFORT=
LLM_FORCE_TOOL_CHOICE=true

HOT_PATH_PROVIDER=
HOT_PATH_MODEL=
HOT_PATH_BASE_URL=
HOT_PATH_API_KEY=
HOT_PATH_MAX_CONTEXT_TOKENS=128000
HOT_PATH_MAX_OUTPUT_TOKENS=
HOT_PATH_REASONING_EFFORT=
HOT_PATH_MAX_TURNS=20

WORKER_PROVIDER=
WORKER_MODEL=
WORKER_BASE_URL=
WORKER_API_KEY=
WORKER_MAX_CONTEXT_TOKENS=128000
WORKER_MAX_OUTPUT_TOKENS=
WORKER_REASONING_EFFORT=
WORKER_MAX_TURNS=20

COMPACTOR_PROVIDER=
COMPACTOR_MODEL=
COMPACTOR_BASE_URL=
COMPACTOR_API_KEY=
COMPACTOR_MAX_CONTEXT_TOKENS=128000
COMPACTOR_MAX_OUTPUT_TOKENS=
COMPACTOR_REASONING_EFFORT=
COMPACTOR_MAX_TURNS=5

# ------------------------------------------------------------------------------
# Connectors and Composio
# ------------------------------------------------------------------------------
COMPOSIO_API_KEY=
COMPOSIO_CALLBACK_URL=
COMPOSIO_ALLOWED_TOOLKITS=gmail,googlecalendar,googledrive
COMPOSIO_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Memory providers
# ------------------------------------------------------------------------------
# MEMORY_PROVIDER: none, supermemory, hindsight, honcho, mem0. If unset, Finn infers one provider
# when exactly one provider is configured; keep none to force memory off.
MEMORY_PROVIDER=none
# MEMORY_MODE: hybrid = auto context + tools, context = auto context only, tools = tools only.
MEMORY_MODE=tools
# Auto-recall is fail-open and only applies in hybrid/context modes.
MEMORY_AUTO_RECALL_TIMEOUT_MS=3000
# Max auto-recall results injected into hot-path context (hybrid/context modes).
MEMORY_AUTO_RECALL_MAX_RESULTS=8
# Provision Finn-managed Hindsight mental models + reflect directives (Hindsight only).
MEMORY_PROVISION_MENTAL_MODELS=true

SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai

HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=

HONCHO_API_KEY=
HONCHO_BASE_URL=
HONCHO_WORKSPACE_PREFIX=finn
HONCHO_TIMEOUT_MS=30000

MEM0_API_KEY=
MEM0_BASE_URL=https://api.mem0.ai

# Hindsight compose/control-plane options. Required only for docker-compose.hindsight*.yml.
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b
HINDSIGHT_CP_DATAPLANE_API_URL=

# ------------------------------------------------------------------------------
# My Day and Personal Intelligence
# ------------------------------------------------------------------------------
# Times are user-local and comma-separated HHMM or HH:MM values.
MY_DAY_REFRESH_TIMES=0500,1100,1700
PERSONAL_INTELLIGENCE_REFRESH_TIMES=0000
# Initial per-connector backfill window. Defaults to 30 days.
PERSONAL_INTELLIGENCE_INITIAL_BACKFILL_MS=2592000000
# Incremental overlap subtracted from previous per-connector coverage. Defaults to 6 hours.
PERSONAL_INTELLIGENCE_INCREMENTAL_OVERLAP_MS=21600000
PERSONAL_INTELLIGENCE_TIMEOUT_MS=1800000
PERSONAL_INTELLIGENCE_MAX_STEPS=120

# ------------------------------------------------------------------------------
# Optional research, media, and voice integrations
# ------------------------------------------------------------------------------
EXA_API_KEY=

FAL_API_KEY=
FAL_IMAGE_GEN_MODEL=openai/gpt-image-2
FAL_IMAGE_EDIT_MODEL=openai/gpt-image-2/edit
FAL_VIDEO_GEN_MODEL=bytedance/seedance-2.0/text-to-video
FAL_IMAGE_TO_VIDEO_MODEL=bytedance/seedance-2.0/image-to-video
FAL_VIDEO_EDIT_MODEL=bytedance/seedance-2.0/reference-to-video

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=L0Dsvb3SLTyegXwtm47J
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ------------------------------------------------------------------------------
# Context management and hot-path ingress
# ------------------------------------------------------------------------------
HOT_PATH_HISTORY_TOKEN_BUDGET=12000
HOT_PATH_HISTORY_MESSAGE_TOKEN_BUDGET=4000
HOT_PATH_CURRENT_TURN_TOKEN_BUDGET=12000
HOT_PATH_CHAPTER_SUMMARY_TOKEN_BUDGET=8000
HOT_PATH_HANDOFF_INPUT_TOKEN_BUDGET=12000
HOT_PATH_DAILY_ROLLOVER_HOUR=4
HOT_PATH_DAILY_ROLLOVER_MINUTE=0
HOT_PATH_INGRESS_USER_GROUPING_WINDOW_MS=500
HOT_PATH_INGRESS_MAX_COALESCE_MESSAGES=5

COMPACTION_BUFFER_TOKENS=4000
COMPACTION_BATCH_BACKGROUND=20
COMPACTION_BATCH_AGGRESSIVE=40
COMPACTION_BATCH_EMERGENCY=30
COMPACTION_MAX_PASSES=3
COMPACTION_THRESHOLD_WARN=0.70
COMPACTION_THRESHOLD_BACKGROUND=0.80
COMPACTION_THRESHOLD_AGGRESSIVE=0.90
COMPACTION_THRESHOLD_EMERGENCY=0.95

# ------------------------------------------------------------------------------
# Workers, files, and agentOS workspace
# ------------------------------------------------------------------------------
BACKGROUND_LLM_TIMEOUT_MS=900000
WORKER_TIMEOUT_MS=900000
WORKER_MAX_CONCURRENT=5
WORKER_MAX_TOOL_CALLS=50
MAX_FILE_SIZE_MB=100

WORKER_WORKSPACES_PATH=./workspaces
# Optional Node overrides for agentOS Core. AGENTOS_CLI_NODE_PATH only matters
# when the Node path used to launch the sidecar is not valid inside workspace shells.
AGENTOS_NODE_PATH=
AGENTOS_CLI_NODE_PATH=

# ------------------------------------------------------------------------------
# Patterns, MCP, and browser-tool compatibility
# ------------------------------------------------------------------------------
PATTERN_CIRCUIT_BREAKER_THRESHOLD=3
MCP_CONFIG_PATH=./mcp.json
# Reserved for legacy/browser-use setups; not required by the core runtime.
BROWSER_USE_API_KEY=

# ------------------------------------------------------------------------------
# Telemetry and deployment helpers
# ------------------------------------------------------------------------------
TELEMETRY_PROVIDER=none
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
OTEL_SERVICE_NAME=finn
OTEL_SERVICE_VERSION=1.0.0
CLOUDFLARE_TUNNEL_TOKEN=
