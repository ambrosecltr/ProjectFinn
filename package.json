{
  "name": "finn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/db",
    "packages/llm",
    "packages/agents",
    "packages/tools",
    "packages/toolsets",
    "packages/runtime",
    "packages/messaging",
    "packages/media",
    "packages/patterns",
    "packages/integrations",
    "packages/puter",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "bun run --watch packages/server/src/index.ts",
    "start": "bun run packages/server/src/index.ts",
    "build": "bun run web:build && bun build packages/server/src/index.ts --outdir dist --target bun",
    "web:dev": "bun run --cwd packages/web dev",
    "web:build": "bun run --cwd packages/web build",
    "docs:dev": "sh -c 'cd docs && bunx mint dev'",
    "docs:validate": "sh -c 'cd docs && bunx mint validate'",
    "docs:broken-links": "sh -c 'cd docs && bunx mint broken-links'",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "check": "tsc --noEmit",
    "test": "bun test",
    "security:sandbox": "TELEMETRY_PROVIDER=none bun run packages/server/src/security-sandbox/cli.ts",
    "security:sandbox:corpus": "TELEMETRY_PROVIDER=none bun run packages/server/src/security-sandbox/cli.ts --corpus --all-profiles",
    "memory:backfill": "bun run packages/server/src/scripts/memory-backfill.ts",
    "supermemory:backfill": "bun run packages/server/src/scripts/memory-backfill.ts --provider supermemory"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/fireworks": "^2",
    "@ai-sdk/openai": "^3",
    "@ai-sdk/openai-compatible": "^2",
    "@composio/core": "^0.10.0",
    "@composio/vercel": "^0.9.2",
    "@daytona/sdk": "^0.171.0",
    "@fal-ai/client": "^1.9.5",
    "@firecrawl/pdf-inspector": "^1.8.14",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@paper-design/shaders-react": "0.0.76",
    "@posthog/ai": "^7.17.4",
    "@silk-hq/components": "0.10.1",
    "@vitejs/plugin-react": "^5.1.2",
    "ai": "^6",
    "drizzle-orm": "^0.39",
    "exceljs": "^4.4.0",
    "graphile-worker": "^0.16.6",
    "hono": "^4",
    "mammoth": "^1.12.0",
    "nanoid": "^5",
    "pino": "^9",
    "pino-pretty": "^13",
    "postgres": "^3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "skills": "^1.5.1",
    "spectrum-ts": "^1.13.1",
    "supermemory": "^4.21.1",
    "vite": "^7.3.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "drizzle-kit": "^0.30",
    "lucide-react": "^1.17.0",
    "typescript": "^5"
  },
  "patchedDependencies": {
    "spectrum-ts@1.13.1": "patches/spectrum-ts@1.13.1.patch"
  }
}
